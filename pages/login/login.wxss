/* pages/login/login.wxss */
/* 全局样式 */
page {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 登录容器 */
.login-container {
  width: 90%;
  max-width: 400px;
  background: white;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
  animation: fadeIn 0.5s ease-in-out;
}

/* 标题样式 */
.login-title {
  text-align: center;
  margin-bottom: 60rpx;
}

.title-text {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle-text {
  display: block;
  font-size: 24rpx;
  color: #666;
}

/* 角色选择器 */
.role-selector {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  padding: 4rpx;
}

.role-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 8rpx;
  transition: all 0.3s ease;
}

.role-item.active {
  background: #708bff;
}

.role-text {
  font-size: 24rpx;
  font-weight: 500;
  transition: color 0.3s ease;
}

.role-item.active .role-text {
  color: white;
}

/* 登录表单 */
.login-form {
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  transition: border-color 0.3s ease;
}

.input:focus {
  border-color: #708bff;
  outline: none;
  box-shadow: 0 0 0 4rpx rgba(112, 139, 255, 0.1);
}

.placeholder {
  color: #999;
}

/* 错误提示 */
.error-message {
  color: #ff4d4f;
  font-size: 20rpx;
  margin: 20rpx 0;
  text-align: center;
  animation: shake 0.3s ease-in-out;
}

/* 登录按钮 */
.login-button {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 10rpx;
  margin-top: 20rpx;
}

/* 底部信息 */
.footer {
  text-align: center;
  margin-top: 40rpx;
}

.footer-text {
  font-size: 20rpx;
  color: #999;
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes shake {
  0%, 100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-5rpx);
  }
  75% {
    transform: translateX(5rpx);
  }
}

/* 响应式设计 */
@media (max-width: 375px) {
  .login-container {
    padding: 40rpx 30rpx;
  }
  
  .title-text {
    font-size: 32rpx;
  }
  
  .input {
    height: 70rpx;
  }
  
  .login-button {
    height: 70rpx;
  }
}